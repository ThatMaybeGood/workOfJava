<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reports.mapper.MiReconMedInstMapper">

    <resultMap id="orgDtlMap" type="com.reports.dto.response.cash.mi.MiReconOrgDtlItem">
        <result property="settleDate" column="settle_date"/>
        <result property="qty" column="qty"/>
        <result property="fee" column="fee"/>
        <result property="insurType" column="insur_type"/>
        <result property="insurTypeName" column="insur_type_name"/>
        <result property="sourceType" column="source_type"/>
    </resultMap>

    <!-- 医疗机构侧对账数据(医保结算库powerips的ips_dz_biz_bills)
         入参: insurType=类型代码(310/390/3101/3901), startDate/endDate=yyyy-MM-dd(对账月份1号~月末)
         6字段: settle_date日期, qty数量, fee医疗总金额, insur_type类型代码, insur_type_name类型名称, source_type来源类型
         按来源类型UNION ALL: 账平(zp_flag=1)已补, 医保负金额/医保正金额两块待补(下方TODO骨架, 解开注释填条件即可);
         单块内已按bill_date分组(一天一行), Java侧再按日期+来源类型聚合 -->
    <select id="queryOrgData" resultMap="orgDtlMap">
        SELECT source_type,
               settle_date,
               qty,
               fee,
               insur_type,
               insur_type_name
        FROM (
            <!-- 账平 -->
            SELECT '账平' AS source_type,
                   a.bill_date AS settle_date,
                   COUNT(a.setl_id) AS qty,
                   SUM(a.medfee_sumamt) AS fee,
                   a.insutype AS insur_type,
                   DECODE(a.insutype, '310', '职工', '390', '居民', '3101', '异地职工', '3901', '异地居民') AS insur_type_name
            FROM ips_dz_biz_bills a
            WHERE a.zp_flag = 1
              AND a.bill_date BETWEEN TO_DATE(#{startDate}, 'yyyy-mm-dd') AND TO_DATE(#{endDate}, 'yyyy-mm-dd')
              AND a.insutype = #{insurType}
            GROUP BY a.insutype, a.bill_date
            <!-- TODO 医保负金额(医保负=his正交易): 解开注释, 把过滤条件换成实际口径
            UNION ALL
            SELECT '医保负金额' AS source_type,
                   a.bill_date AS settle_date,
                   COUNT(a.setl_id) AS qty,
                   SUM(a.medfee_sumamt) AS fee,
                   a.insutype AS insur_type,
                   DECODE(a.insutype, '310', '职工', '390', '居民', '3101', '异地职工', '3901', '异地居民') AS insur_type_name
            FROM ips_dz_biz_bills a
            WHERE ...条件待补...
              AND a.bill_date BETWEEN TO_DATE(#{startDate}, 'yyyy-mm-dd') AND TO_DATE(#{endDate}, 'yyyy-mm-dd')
              AND a.insutype = #{insurType}
            GROUP BY a.insutype, a.bill_date
            -->
            <!-- TODO 医保正金额: 同上, source_type='医保正金额'
            UNION ALL
            SELECT '医保正金额' AS source_type, ...同结构...
            -->
        )
        ORDER BY settle_date, source_type
    </select>

</mapper>
