<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reports.mapper.OutpatientFinanceMapper">

    <!-- ============================================================ -->
    <!-- 通用片段：日期范围（归一化后 startDate/endDate 已是真实日期边界） -->
    <!-- ============================================================ -->
    <sql id="dateRangeClause">
        AND ${col} BETWEEN #{startDate} AND #{endDate}
    </sql>

    <!-- 周期表达式：月模式 YYYY-MM / 天模式 YYYY-MM-DD（仅 GROUP BY 用） -->
    <sql id="periodExpr">
        <choose>
            <when test="timeType == 1">TO_CHAR(${col},'YYYY-MM')</when>
            <otherwise>TO_CHAR(${col},'YYYY-MM-DD')</otherwise>
        </choose>
    </sql>

    <!-- 收据进项/退项筛选（rcpt_type=2 进项 / 3 退项） -->
    <!-- 进项：total_charges >= 0（含 NULL 视为正） -->
    <!-- 退项：refunded_rcpt_no IS NOT NULL AND total_charges &lt; 0 -->
    <sql id="rcptTypeFilter">
        <if test="statisticType == 2">AND NVL(r.TOTAL_CHARGES, 0) &gt;= 0</if>
        <if test="statisticType == 3">AND r.REFUNDED_RCPT_NO IS NOT NULL AND r.TOTAL_CHARGES &lt; 0</if>
    </sql>

    <!-- 挂号净量 CASE 表达式（门诊量指标①） -->
    <!-- T1(汇总)=净量(未退号−退号)；T2=未退号计数；T3=退号计数 -->
    <sql id="clinicNetCase">
        <choose>
            <when test="statisticType == 1">SUM(CASE WHEN c.RETURNED_DATE IS NULL THEN 1 ELSE -1 END)</when>
            <when test="statisticType == 2">SUM(CASE WHEN c.RETURNED_DATE IS NULL THEN 1 ELSE 0 END)</when>
            <otherwise>SUM(CASE WHEN c.RETURNED_DATE IS NOT NULL THEN 1 ELSE 0 END)</otherwise>
        </choose>
    </sql>

    <!-- 结账金额表达式（TR_OUTP_FIN_ACCT_MASTER）：T1 净额 / T2 含退 / T3 退费 -->
    <sql id="acctAmountExpr">
        <choose>
            <when test="statisticType == 1">NVL(SUM(NVL(a.TOTAL_COSTS,0)),0)</when>
            <when test="statisticType == 2">NVL(SUM(NVL(a.TOTAL_COSTS,0)+NVL(a.REFUND_AMOUNT,0)),0)</when>
            <otherwise>NVL(SUM(NVL(a.REFUND_AMOUNT,0)),0)</otherwise>
        </choose>
    </sql>

    <!-- 结账张数表达式 -->
    <sql id="acctReceiptExpr">
        <choose>
            <when test="statisticType == 1">NVL(SUM(NVL(a.RCPTS_NUM,0)),0)</when>
            <when test="statisticType == 2">NVL(SUM(NVL(a.RCPTS_NUM,0)+NVL(a.REFUND_NUM,0)),0)</when>
            <otherwise>NVL(SUM(NVL(a.REFUND_NUM,0)),0)</otherwise>
        </choose>
    </sql>

    <!-- 支付金额表达式（TR_OUTP_FIN_PAYMENTS_MONEY）：T1 实收-退 / T2 实收 / T3 退费 -->
    <sql id="paymentAmountExpr">
        <choose>
            <when test="statisticType == 1">NVL(SUM(NVL(p.PAYMENT_AMOUNT,0)-NVL(p.REFUNDED_AMOUNT,0)),0)</when>
            <when test="statisticType == 2">NVL(SUM(NVL(p.PAYMENT_AMOUNT,0)),0)</when>
            <otherwise>NVL(SUM(NVL(p.REFUNDED_AMOUNT,0)),0)</otherwise>
        </choose>
    </sql>

    <!-- ============================================================ -->
    <!-- 1. 门诊量净口径：按 visit_date 分组 -->
    <!-- ============================================================ -->
    <select id="queryClinicCounts" resultType="map">
        SELECT
            <include refid="periodExpr"><property name="col" value="c.VISIT_DATE"/></include> AS "period",
            <include refid="clinicNetCase"/> AS "cnt"
        FROM TR_OUTP_FIN_CLINIC_MASTER c
        WHERE 1=1
            <include refid="dateRangeClause"><property name="col" value="c.VISIT_DATE"/></include>
        GROUP BY <include refid="periodExpr"><property name="col" value="c.VISIT_DATE"/></include>
        ORDER BY "period"
    </select>

    <!-- ============================================================ -->
    <!-- 2. 收据张数/金额：按 acct_date 分组 -->
    <!-- ============================================================ -->
    <select id="queryAcctAmounts" resultType="map">
        SELECT
            <include refid="periodExpr"><property name="col" value="a.ACCT_DATE"/></include> AS "period",
            <include refid="acctAmountExpr"/> AS "amount",
            <include refid="acctReceiptExpr"/> AS "receipt"
        FROM TR_OUTP_FIN_ACCT_MASTER a
        WHERE 1=1
            <include refid="dateRangeClause"><property name="col" value="a.ACCT_DATE"/></include>
        GROUP BY <include refid="periodExpr"><property name="col" value="a.ACCT_DATE"/></include>
        ORDER BY "period"
    </select>

    <!-- ============================================================ -->
    <!-- 3. 门诊收据原始行：人次去重在 Service -->
    <!-- ============================================================ -->
    <select id="queryRcptRows" resultType="com.reports.entity.cash.OutpFinanceRcptAcct">
        SELECT
            r.RCPT_NO            AS "rcptNo",
            r.PATIENT_ID         AS "patientId",
            r.VISIT_DATE         AS "visitDate",
            r.TOTAL_CHARGES      AS "totalCharges",
            r.REFUNDED_RCPT_NO   AS "refundedRcptNo",
            r.OPERATOR_NO        AS "operatorNo",
            r.BILL_CLASS         AS "billClass",
            r.CREATE_TIME        AS "createTime",
            r.UPDATE_TIME        AS "updateTime"
        FROM TR_OUTP_FIN_RCPT_ACCT r
        WHERE 1=1
            <include refid="rcptTypeFilter"/>
            <include refid="dateRangeClause"><property name="col" value="r.VISIT_DATE"/></include>
        ORDER BY r.PATIENT_ID, r.RCPT_NO
    </select>

    <!-- ============================================================ -->
    <!-- 4. 门诊挂号原始行：bt8 分界前挂号费 -->
    <!-- ============================================================ -->
    <select id="queryClinicRows" resultType="com.reports.entity.cash.OutpFinanceClinicMaster">
        SELECT
            c.PATIENT_ID         AS "patientId",
            c.VISIT_DATE         AS "visitDate",
            c.RETURNED_DATE      AS "returnedDate",
            c.REGIST_FEE         AS "registFee",
            c.CLINIC_FEE         AS "clinicFee",
            c.CLINIC_LABEL       AS "clinicLabel",
            c.VISIT_TIME_DESC    AS "visitTimeDesc",
            c.OPERATOR_NO        AS "operatorNo",
            c.CREATE_TIME        AS "createTime",
            c.UPDATE_TIME        AS "updateTime"
        FROM TR_OUTP_FIN_CLINIC_MASTER c
        WHERE 1=1
            <include refid="dateRangeClause"><property name="col" value="c.VISIT_DATE"/></include>
        ORDER BY c.VISIT_DATE
    </select>

    <!-- ============================================================ -->
    <!-- 5. bt1/bt3/bt4 订单来源/渠道：按操作员计数 -->
    <!-- ============================================================ -->
    <select id="queryRcptCountByOperator" resultType="map">
        SELECT r.OPERATOR_NO AS "name",
               SUM(CASE WHEN NVL(r.TOTAL_CHARGES, 0) &gt;= 0 THEN 1 ELSE -1 END) AS "cnt"
        FROM TR_OUTP_FIN_RCPT_ACCT r
        WHERE 1=1
            <include refid="dateRangeClause"><property name="col" value="r.VISIT_DATE"/></include>
            <if test="statisticType == 2">AND NVL(r.TOTAL_CHARGES, 0) &gt;= 0</if>
            <if test="statisticType == 3">AND r.REFUNDED_RCPT_NO IS NOT NULL AND r.TOTAL_CHARGES &lt; 0</if>
        GROUP BY r.OPERATOR_NO
        ORDER BY "cnt" DESC
    </select>

    <!-- ============================================================ -->
    <!-- 6. bt6 渠道金额：按操作员求和 -->
    <!-- ============================================================ -->
    <select id="queryRcptSumByOperator" resultType="map">
        SELECT r.OPERATOR_NO AS "name",
               SUM(CASE WHEN NVL(r.TOTAL_CHARGES, 0) &gt;= 0 THEN NVL(r.TOTAL_CHARGES, 0) ELSE -NVL(r.TOTAL_CHARGES, 0) END) AS "amount"
        FROM TR_OUTP_FIN_RCPT_ACCT r
        WHERE 1=1
            <include refid="dateRangeClause"><property name="col" value="r.VISIT_DATE"/></include>
            <if test="statisticType == 2">AND NVL(r.TOTAL_CHARGES, 0) &gt;= 0</if>
            <if test="statisticType == 3">AND r.REFUNDED_RCPT_NO IS NOT NULL AND r.TOTAL_CHARGES &lt; 0</if>
        GROUP BY r.OPERATOR_NO
        ORDER BY "amount" DESC
    </select>

    <!-- ============================================================ -->
    <!-- 7. bt2 取号渠道：MOP_QUEUE 直接查（reserve+used + returned_date 非空） -->
    <!-- ============================================================ -->
    <select id="queryQueueCountByOperator" resultType="map">
        SELECT c.OPERATOR_NO AS "name",
               SUM(CASE WHEN c.RETURNED_DATE IS NULL THEN 1 ELSE -1 END) AS "cnt"
        FROM TR_OUTP_FIN_CLINIC_MASTER c
        JOIN TR_OUTP_FIN_MOP_QUEUE q
          ON q.SCHEDULE_ID = c.CLINIC_LABEL || '|' || TO_CHAR(c.VISIT_DATE,'YYYYMMDD') || '|' || c.VISIT_TIME_DESC
         AND q.PATIENT_ID  = c.PATIENT_ID
        WHERE q.QUEUE_TYPE = 'reserve'
          AND q.IS_USED    = 'used'
          AND c.RETURNED_DATE IS NOT NULL
          <include refid="dateRangeClause"><property name="col" value="c.VISIT_DATE"/></include>
        GROUP BY c.OPERATOR_NO
        ORDER BY "cnt" DESC
    </select>

    <!-- ============================================================ -->
    <!-- 8. bt5 人次支付：PAYMENTS_MONEY ⋈ RCPT_ACCT 按 MoneyType 去重人次 -->
    <!-- ============================================================ -->
    <select id="queryPaymentCountByMoneyType" resultType="map">
        SELECT p.MONEY_TYPE AS "name",
               COUNT(DISTINCT NVL(rc.PATIENT_ID,'-') || '|' || NVL(p.RCPT_NO,'-')) AS "cnt"
        FROM TR_OUTP_FIN_PAYMENTS_MONEY p
        JOIN TR_OUTP_FIN_RCPT_ACCT rc ON rc.RCPT_NO = p.RCPT_NO
        WHERE 1=1
            <include refid="dateRangeClause"><property name="col" value="rc.VISIT_DATE"/></include>
            <if test="statisticType == 2">AND NVL(p.PAYMENT_AMOUNT,0) &gt; 0</if>
            <if test="statisticType == 3">AND NVL(p.REFUNDED_AMOUNT,0) &gt; 0</if>
        GROUP BY p.MONEY_TYPE
        ORDER BY "cnt" DESC
    </select>

    <!-- ============================================================ -->
    <!-- 9. bt7 支付方式金额：PAYMENTS_MONEY ⋈ RCPT_ACCT 按 MoneyType 求和 -->
    <!-- ============================================================ -->
    <select id="queryPaymentSumByMoneyType" resultType="map">
        SELECT p.MONEY_TYPE AS "name",
               <include refid="paymentAmountExpr"/> AS "amount"
        FROM TR_OUTP_FIN_PAYMENTS_MONEY p
        JOIN TR_OUTP_FIN_RCPT_ACCT rc ON rc.RCPT_NO = p.RCPT_NO
        WHERE 1=1
            <include refid="dateRangeClause"><property name="col" value="rc.VISIT_DATE"/></include>
        GROUP BY p.MONEY_TYPE
        ORDER BY "amount" DESC
    </select>

    <!-- ============================================================ -->
    <!-- 10. bt9 应收/实收：PAYMENTS_MONEY ⋈ RCPT_ACCT，按 MoneyType 归类 -->
    <!-- 医改统筹/医院垫支 → 应收账款；现金/微信/支付宝/银行卡/医保/自助POS/支票 → 实收；其余 → 其他 -->
    <!-- ============================================================ -->
    <select id="queryPaymentSumByCategory" resultType="map">
        SELECT
            CASE
                WHEN p.MONEY_TYPE IN ('医改统筹','医院垫支') THEN '应收账款'
                WHEN p.MONEY_TYPE IN ('支付宝','现金','信用卡','银行卡','微信','自助POS','支票') THEN '实收金额'
                ELSE '其他'
            END AS "name",
            <include refid="paymentAmountExpr"/> AS "amount"
        FROM TR_OUTP_FIN_PAYMENTS_MONEY p
        JOIN TR_OUTP_FIN_RCPT_ACCT rc ON rc.RCPT_NO = p.RCPT_NO
        WHERE 1=1
            <include refid="dateRangeClause"><property name="col" value="rc.VISIT_DATE"/></include>
        GROUP BY
            CASE
                WHEN p.MONEY_TYPE IN ('医改统筹','医院垫支') THEN '应收账款'
                WHEN p.MONEY_TYPE IN ('支付宝','现金','信用卡','银行卡','微信','自助POS','支票') THEN '实收金额'
                ELSE '其他'
            END
        ORDER BY "amount" DESC
    </select>

</mapper>
