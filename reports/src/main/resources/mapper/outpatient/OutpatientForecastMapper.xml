<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reports.mapper.OutpatientForecastMapper">

    <!-- 科室过滤条件(关联字典表) -->
    <sql id="deptFilter">
        <if test="deptCode != null and deptCode != ''">
            AND d.dept_code = #{deptCode}
        </if>
        <if test="deptName != null and deptName != ''">
            AND d.dept_name LIKE '%' || #{deptName} || '%'
        </if>
    </sql>

    <!-- ============================================================ -->
    <!-- 预测公式: 预测值 = 去年同期日门诊量 × 增长率(近30天÷去年同期30天) -->
    <!-- 唯一取数: 门诊量按日聚合一次查全(前年1-1~昨天), 区间指标在Java内计算 -->
    <!-- ============================================================ -->

    <!-- 门诊量按日聚合(就诊日归期): 日预测/增长率/月预测全部基础量共用 -->
    <select id="queryDailyVolumeRange" resultType="com.reports.dto.response.outpatient.forecast.ForecastDayRow">
        SELECT TO_CHAR(c.stat_date, 'YYYY-MM-DD') AS dd, -- 日期
               COUNT(1) AS num -- 当日门诊量
        FROM TR_OUTP_FIN_CLINIC_MASTER c
        INNER JOIN TR_DEPT_DICT d ON c.dept_code = d.dept_code
        WHERE c.stat_date BETWEEN #{startDate} AND #{endDate}
        <include refid="deptFilter"/>
        GROUP BY c.stat_date
    </select>

</mapper>
